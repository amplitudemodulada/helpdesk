# Database (Neon Postgres - configurado automaticamente via Vercel)
DATABASE_URL="postgresql://user:password@host:5432/neondb"

# NextAuth
NEXTAUTH_URL="https://helpdesk-amplitudemoduladas-projects.vercel.app"
NEXTAUTH_SECRET="gerar-com: openssl rand -base64 32"

# Resend (Email - opcional)
RESEND_API_KEY="re_xxxxxxx"
EMAIL_FROM="Helpdesk <noreply@helpdesk.com>"

# Segurança (OBRIGATÓRIO - anti-clonagem)
APP_DOMAIN="helpdesk-amplitudemoduladas-projects.vercel.app"
